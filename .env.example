# Copy to .env and fill in. Never commit .env.
ASI_DB_USER=asi
ASI_DB_PASSWORD=
# 64 hex chars (32 bytes): openssl rand -hex 32
ASI_SECRET_KEY=
# Listen address of asi serve (native mode); compose sets it itself.
ASI_HTTP_ADDR=:9080
# Host address the UI is published on (compose; make up-host listens there).
# 127.0.0.1 = this machine only; from a remote machine use an ssh tunnel
# (ssh -L 9080:127.0.0.1:9080 host) or set 0.0.0.0 (plain HTTP: open the port
# in the firewall only for trusted networks).
ASI_BIND=127.0.0.1
# Time zone for scan windows and UI times (compose passes it as TZ).
ASI_TZ=Europe/Warsaw
# Scanning outside these networks is refused (import and right before exec).
# Loopback covers services published by docker on this host; add the host or
# LAN address (e.g. 192.168.1.10/32 or 192.168.1.0/24) to scan it as well.
ASI_ALLOWED_CIDRS=10.20.0.0/18,192.0.2.0/24,127.0.0.0/8,::1/128
# Host names resolved at startup and allowed as single addresses
# (compose.hostgw.yml sets host.docker.internal).
ASI_ALLOW_HOSTS=
# Port profile "auto": all 65535 TCP ports (-p-) for targets totalling at most
# this many addresses, top ports otherwise (0 = never all ports).
ASI_ALL_PORTS_MAX_ADDRS=16
ASI_SCAN_PRIVILEGED=false
# Addresses never scanned (lab: network address, docker gateway, scanner).
ASI_SCAN_EXCLUDE=10.20.0.0,10.20.0.1,10.20.63.250
# Upper bound of a scan config's packets/s (all workers together).
ASI_MAX_RATE=5000
# Allowed TCP ports, e.g. 22,80,443,8000-8100 (empty = top ports of each config).
ASI_SCAN_PORTS=
# Host lifecycle: inactive after N missed runs; unstable after N flips in the last W runs.
ASI_INACTIVE_AFTER_MISSES=3
ASI_UNSTABLE_IF_FLIPS=2
ASI_UNSTABLE_WINDOW=5
# DefectDojo push is off by default (the public demo instance is visible to everyone).
ASI_DOJO_URL=
ASI_DOJO_PUSH=false
# DefectDojo API v2 token, or user/password to obtain one.
ASI_DOJO_TOKEN=
ASI_DOJO_USER=
ASI_DOJO_PASSWORD=
# Initial passwords of the 4 demo users; random ones are printed once if empty.
ASI_SEED_PASSWORD_ADMIN=
ASI_SEED_PASSWORD_EDITOR=
ASI_SEED_PASSWORD_ANALYST=
ASI_SEED_PASSWORD_VIEWER=
